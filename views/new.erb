<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <title>メモの新規作成</title>
</head>
<body>
  <h1><%= @app_name %></h1>
  <form action="/memos" method="POST">
    <table>
      <tr>
        <td>タイトル</td>
      </tr>
      <tr>
        <td>
          <input type="text" name="title" size="31">
        </td>
      </tr>
      <tr>
        <td>内容</td>
      </tr>
      <tr>
        <td>
          <textarea name="content" rows="5" cols="30"></textarea>
        </td>
      </tr>
      
      <tr>
        <td>
          <button type="submit">保存</button>
        </td>
      </tr>
    </table>
  </form>
</body>
</html>
