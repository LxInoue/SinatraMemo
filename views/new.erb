<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <title>メモの新規作成</title>
</head>
<body>
  <h1><%= @app_name %></h1>
  <form action="/memos" method="POST">
    <div>
      <label>タイトル: <input type="text" name="title"></label>
    </div>
    <div>
      <label>内容: <textarea name="content"></textarea></label>
    </div>
    <button type="submit">保存</button>
  </form>
  <a href="/memos">戻る</a>
</body>
</html>
